# Solarman logger reachable from the exporter container.
SOLARMAN_HOST=192.168.1.100
SOLARMAN_SERIAL=1234567890
SOLARMAN_PORT=8899
SOLARMAN_SLAVE_ID=1
SOLARMAN_POLL_INTERVAL_SECONDS=15
SOLARMAN_READY_MAX_AGE_SECONDS=45
SOLARMAN_INVERTER_NAME=deye

# Use an absolute profile path only to override the bundled Deye Hybrid profile.
# SOLARMAN_PROFILE_PATH=/app/profiles/deye_hybrid.yaml
